PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require&uselibpqcompat=true
DATABASE_URL_UNPOOLED=postgresql://user:password@unpooled-host/neondb?sslmode=require&uselibpqcompat=true
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=toddybear
DB_SSL=true

# JWT
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRATION=7d

# External APIs
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
AI_PROVIDER=gemini
CARTESIA_API_KEY=your-cartesia-api-key
CARTESIA_VOICE_ID=6ccbfb76-1fc6-48f7-b71d-91ac6298247b
CARTESIA_MODEL=sonic-3.5
STT_PROVIDER=groq

# Cloudinary Cloud Storage
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# OTP
OTP_EXPIRATION_MINUTES=5

# Super Admin Credentials
SUPER_ADMIN_EMAIL=superadmin@toddybear.com
SUPER_ADMIN_PASSWORD=your-super-admin-password


